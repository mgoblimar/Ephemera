# Copy to .env and fill in. Never commit .env.

# false = mock providers (free, offline). true = real Meta Model API calls (uses credits).
USE_REAL_PROVIDERS=false

# Your Model API key (META_API_KEY also works).
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# --- Models, one per job (SPEC 5.1) ---
# Testing profile: contributor mode is ~20-100x cheaper, but Meta may train on what you send.
# Use it only with test photos you're fine sharing. Switch both lines back for the demo.
AGENT_MODEL=muse-spark-1.3-contributor
VISION_MODEL=muse-spark-1.3-contributor
# Demo profile:
# AGENT_MODEL=muse-wonder-1.0
# VISION_MODEL=muse-spark-1.3

# No contributor mode exists for these two.
SAM_MODEL=sam-3.1
IMAGE_MODEL=muse-image-1.0

# Requests per minute per client IP.
RATE_LIMIT_PER_MINUTE=60
